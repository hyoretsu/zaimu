PORT=3333
NODE_ENV=development

# Mesmo namespace na API e no worker. Produção: zaimu; desenvolvimento: zaimu_dev.
SERVICE_NAMESPACE=zaimu_dev

# PostgreSQL local sem SSL. Use sslmode=verify-full para habilitar SSL com certificado válido.
# O sslmode na URL tem precedência sobre PGSSLMODE; configure também a URL usada pelo pacote sql.
DATABASE_URL="postgresql://username:password@localhost:5432/zaimu?sslmode=disable"
DATABASE_TEST_URL="postgresql://username:password@localhost:5432/zaimu_test?sslmode=disable"
BETTER_AUTH_SECRET="gere-um-segredo-com-pelo-menos-32-caracteres"
BETTER_AUTH_URL="http://localhost:3333"
PUBLIC_WEB_URL="http://localhost:5173"

# Cache distribuído. Redis indisponível degrada para acesso direto ao banco.
REDIS_URL="redis://localhost:6379"

# Filas duráveis e worker de materialização. Execute `bun run dev` em desenvolvimento.
# Para recompor ocorrências vencidas sob demanda, execute `bun run schedule:replay` com o worker ativo.
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_CONSUMER_PREFETCH=1
RABBITMQ_MAX_RETRIES=5
SCHEDULE_MATERIALIZATION_INTERVAL_MS=60000

SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="usuario"
SMTP_PASSWORD="senha"
SMTP_FROM="Zaimu <nao-responda@example.com>"

# Optional MeuPluggy integration: 32 random bytes encoded as 64 hexadecimal characters.
# Generate locally: openssl rand -hex 32. Keep this key stable while credentials exist.
OPEN_FINANCE_ENCRYPTION_KEY=
