{
	"$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"extends": ["@hyoretsu/configs/biome-elysia"],
	"files": {
		"includes": ["!db/types.ts", "!generated", "!src/generated"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"rules": {
			"nursery": {
				"useSortedClasses": "off"
			}
		}
	},
	"root": false
}
