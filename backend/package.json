{
	"name": "backend",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build src/main.ts src/worker.ts --target bun --outdir ./dist",
		"check-types": "tsc --noEmit",
		"dev": "bun --watch src/main.ts",
		"dev:worker": "bun --watch src/worker.ts",
		"performance:benchmark": "bun run performance/benchmark.ts",
		"performance:seed": "bun run performance/seed.ts",
		"schedule:replay": "bun run src/scripts/replay-schedule-materialization.ts",
		"start": "NODE_ENV=production bun dist/main.js",
		"start:worker": "NODE_ENV=production bun dist/worker.js",
		"test": "bun test",
		"test:e2e": "bun run tests/run-e2e.ts",
		"test:unit": "bun test src"
	},
	"dependencies": {
		"@better-auth/core": "1.7.1",
		"@elysiajs/bearer": "^1.4.4",
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/jwt": "^1.4.2",
		"@elysiajs/openapi": "^1.4.15",
		"@zaimu/finance": "workspace:*",
		"amqplib": "^2.0.1",
		"better-auth": "1.7.1",
		"cron-validate": "^1.5.3",
		"date-fns": "^4.4.0",
		"elysia": "^1.4.30",
		"jose": "^6.2.10",
		"nodemailer": "^9.0.6",
		"pdf-parse": "^2.4.5",
		"sql": "workspace:*"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.37",
		"@types/amqplib": "^0.10.8",
		"@types/bun": "^1.4.0",
		"@types/node": "^25.9.5",
		"@types/nodemailer": "^8.0.1",
		"dotenv": "^17.4.2",
		"http-status-codes": "^2.3.0",
		"typescript": "^6.0.3"
	}
}
