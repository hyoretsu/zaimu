// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  model User {
    id                VarChar(36)        @id(map: "User_pkey") @default(dbgenerated("cuid2()"))
    email             VarChar(320)
    name              VarChar(100)
    createdAt         Timestamp(3)       @default(now())
    updatedAt         Timestamp(3)       @default(now())
    emailVerified     Boolean            @default(false)
    image             VarChar(2048)?
    categories        Category[]
    stores            Store[]
    debts             Debt[]
    debtPeople        DebtPerson[]
    debtEvents        DebtEvent[]
    debtEventVisibilities DebtEventVisibility[]
    debtTransactionLinks DebtTransactionLink[]
    debtPurchaseLinks DebtPurchaseLink[]
    debtSplits        DebtSplit[]
    requestedDebtConnections DebtConnection[] @relation(name: "DebtConnection_requesterId_fkey")
    receivedDebtConnections DebtConnection[] @relation(name: "DebtConnection_recipientId_fkey")
    financialAccounts FinancialAccount[]
    balanceAdjustments BalanceAdjustment[]
    financialAccountYieldHolidays FinancialAccountYieldHoliday[]
    financialInstitutions FinancialInstitution[]
    loans             Loan[]
    salaries          Salary[]
    subscriptions     Subscription[]
    creditCardImports CreditCardImport[]
    transactionImports TransactionImport[]
    transactionImportTransferSuggestionRejections TransactionImportTransferSuggestionRejection[]
    transactionTransferSuggestionRejections TransactionTransferSuggestionRejection[]
    transactions      Transaction[]
    normalizedCreditPurchases CreditPurchaseRecord[]
    authAccounts      AuthAccount[]
    sessions          Session[]

    @@index([email], map: "User_email_key", unique: true)
    @@map("user")
  }

  model FinancialInstitution {
    id             VarChar(36)        @id(map: "FinancialInstitution_pkey") @default(dbgenerated("cuid2()"))
    userId         VarChar(36)
    name           VarChar(100)
    normalizedName VarChar(100)
    createdAt      Timestamp(3)       @default(now())
    updatedAt      Timestamp(3)       @default(now())
    financialAccounts FinancialAccount[]
    yieldPolicies     FinancialInstitutionYieldPolicy[]
    creditRefundPolicy pg.enum(CreditRefundPolicy)?
    user           User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FinancialInstitution_userId_fkey", index: false)

    @@index([userId, normalizedName], map: "FinancialInstitution_userId_normalizedName_key", unique: true)
    @@map("FinancialInstitution")
  }

  model FinancialInstitutionYieldPolicy {
    id                     VarChar(36)                              @id(map: "FinancialInstitutionYieldPolicy_pkey") @default(dbgenerated("cuid2()"))
    financialInstitutionId VarChar(36)
    effectiveDate          Date
    yieldPeriod            pg.enum(FinancialAccountYieldPeriod)?
    yieldTaxRate           Numeric(5, 2)?
    createdAt              Timestamp(3)                             @default(now())
    updatedAt              Timestamp(3)                             @default(now())
    financialInstitution   FinancialInstitution                    @relation(fields: [financialInstitutionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FinancialInstitutionYieldPolicy_financialInstitutionId_fkey", index: false)
    rules                  FinancialInstitutionYieldRule[]

    @@index([financialInstitutionId, effectiveDate], map: "FinancialInstitutionYieldPolicy_institutionId_effectiveDate_key", unique: true)
    @@map("FinancialInstitutionYieldPolicy")
  }

  model FinancialInstitutionYieldRule {
    id                       VarChar(36)                       @id(map: "FinancialInstitutionYieldRule_pkey") @default(dbgenerated("cuid2()"))
    financialYieldPolicyId   VarChar(36)
    position                 SmallInt
    upToBalance              Numeric(12, 2)?
    yieldReferenceType       pg.enum(ReferenceRateType)?
    yieldReferencePercentage Numeric(7, 4)?
    yieldFixedRate           Numeric(7, 4)?
    createdAt                Timestamp(3)                      @default(now())
    updatedAt                Timestamp(3)                      @default(now())
    financialYieldPolicy     FinancialInstitutionYieldPolicy   @relation(fields: [financialYieldPolicyId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FinancialInstitutionYieldRule_financialYieldPolicyId_fkey", index: false)

    @@index([financialYieldPolicyId, position], map: "FinancialInstitutionYieldRule_policyId_position_key", unique: true)
    @@map("FinancialInstitutionYieldRule")
  }

  model AuthAccount {
    id                    VarChar(36)   @id(map: "account_pkey") @default(dbgenerated("cuid2()"))
    issuer                VarChar(320)
    accountId             VarChar(320)
    providerId            VarChar(100)
    userId                VarChar(36)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  Timestamp(3)?
    refreshTokenExpiresAt Timestamp(3)?
    scope                 String?
    password              VarChar(255)?
    createdAt             Timestamp(3)  @default(now())
    updatedAt             Timestamp(3)  @default(now())
    user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")

    @@index([providerId, accountId], map: "account_providerId_accountId_key", unique: true)
    @@index([issuer, accountId], map: "account_issuer_accountId_key", unique: true)
    @@index([userId], map: "account_userId_idx")
    @@map("account")
  }

  model Category {
    id                VarChar(36)        @id(map: "Category_pkey") @default(dbgenerated("cuid2()"))
    userId            VarChar(36)
    name              VarChar(50)
    color             VarChar(7)?
    icon              VarChar(50)?
    parentId          VarChar(36)?
    createdAt         Timestamp(3)       @default(now())
    updatedAt         Timestamp(3)       @default(now())
    creditCardImportItems CreditCardImportItem[]
    normalizedCreditPurchases CreditPurchaseRecord[]
    recurringPayments RecurringPayment[]
    transactions      Transaction[]
    transactionImportItems TransactionImportItem[]
    tagAssignments    TagAssignment[]
    parent            Category?          @relation(name: "Category_parentId_fkey", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Category_parentId_fkey", index: false)
    categories        Category[]         @relation(name: "Category_parentId_fkey")
    user              User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Category_userId_fkey", index: false)

    @@index([userId, name], map: "Category_userId_name_key", unique: true)

    @@map("Category")
  }

  model Store {
    id             VarChar(36)  @id(map: "Store_pkey") @default(dbgenerated("cuid2()"))
    userId         VarChar(36)
    name           VarChar(200)
    normalizedName VarChar(200)
    createdAt      Timestamp(3) @default(now())
    updatedAt      Timestamp(3) @default(now())
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Store_userId_fkey", index: false)

    @@index([userId, normalizedName], map: "Store_userId_normalizedName_key", unique: true)
    @@map("Store")
  }

  model TagAssignment {
    id         VarChar(36)  @id(map: "TagAssignment_pkey") @default(dbgenerated("cuid2()"))
    categoryId VarChar(36)
    entityType VarChar(50)
    entityId   VarChar(36)
    createdAt  Timestamp(3) @default(now())
    updatedAt  Timestamp(3) @default(now())
    category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TagAssignment_categoryId_fkey", index: false)

    @@index([categoryId, entityType, entityId], map: "TagAssignment_categoryId_entityType_entityId_key", unique: true)
    @@index([entityType, entityId], map: "TagAssignment_entityType_entityId_idx")

    @@map("TagAssignment")
  }

  model FinancialAccount {
    id                      VarChar(36)                   @id(map: "Account_pkey") @default(dbgenerated("cuid2()"))
    userId                  VarChar(36)
    name                    VarChar(70)?
    type                    pg.enum(FinancialAccountType) @default("CHECKING")
    balance                 Numeric(12, 2)?               @default(dbgenerated("0"))
    institutionId           VarChar(36)?
    yieldReferenceType       pg.enum(ReferenceRateType)?
    yieldReferencePercentage Numeric(7, 4)?
    yieldFixedRate           Numeric(7, 4)?
    yieldTaxRate             Numeric(5, 2)?
    yieldPeriod              pg.enum(FinancialAccountYieldPeriod)?
    createdAt               Timestamp(3)                  @default(now())
    updatedAt               Timestamp(3)                  @default(now())
    creditCards             CreditCard[]                     @relation(name: "CreditCard_accountId_fkey")
    cashbackCreditCards     CreditCard[]                     @relation(name: "CreditCard_cashbackAccountId_fkey")
    yields                  FinancialAccountYield[]
    balanceAdjustments      BalanceAdjustment[]
    yieldRateHistories      FinancialAccountYieldRateHistory[]
    loanPayments            LoanPayment[]
    purchaseCashback        CreditPurchaseRecord[] @relation("PurchaseCashback")
    rewardsAccount          RewardsAccount?
    salaries                Salary[]
    recurringPayments       RecurringPayment[]
    subscriptions           Subscription[]
    user                    User                          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Account_userId_fkey", index: false)
    institution             FinancialInstitution?          @relation(fields: [institutionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "FinancialAccount_institutionId_fkey", index: false)
    transactions            Transaction[]                 @relation(name: "Transaction_destinationId_fkey")
    transactionsTransaction Transaction[]                 @relation(name: "Transaction_originId_fkey")
    transactionImports     TransactionImport[]
    transactionExternalReferences TransactionExternalReference[]
    importedTransactionItemsAsOrigin TransactionImportItem[] @relation(name: "TransactionImportItem_originId_fkey")
    importedTransactionItemsAsDestination TransactionImportItem[] @relation(name: "TransactionImportItem_destinationId_fkey")
    rejectedOutgoingTransferSuggestions TransactionImportTransferSuggestionRejection[] @relation(name: "TransactionImportTransferSuggestionRejection_outgoingAccountId_fkey")
    rejectedIncomingTransferSuggestions TransactionImportTransferSuggestionRejection[] @relation(name: "TransactionImportTransferSuggestionRejection_incomingAccountId_fkey")

    @@index([institutionId], map: "FinancialAccount_institutionId_idx")
    @@index([userId, institutionId, name, type], map: "FinancialAccount_userId_institutionId_name_type_key", unique: true)

    @@map("FinancialAccount")
  }

  model FinancialAccountYieldHoliday {
    id        VarChar(36)  @id(map: "FinancialAccountYieldHoliday_pkey") @default(dbgenerated("cuid2()"))
    userId    VarChar(36)
    date      Date
    createdAt Timestamp(3) @default(now())
    updatedAt Timestamp(3) @default(now())
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FinancialAccountYieldHoliday_userId_fkey", index: false)

    @@index([userId, date], map: "FinancialAccountYieldHoliday_userId_date_key", unique: true)
    @@map("FinancialAccountYieldHoliday")
  }

  model BalanceAdjustment {
    id                 VarChar(36) @id(map: "BalanceAdjustment_pkey") @default(dbgenerated("cuid2()"))
    userId             VarChar(36)
    financialAccountId VarChar(36)
    date               Date
    balance            Numeric(12, 2)
    createdAt          Timestamp(3) @default(now())
    updatedAt          Timestamp(3) @default(now())
    user               User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "BalanceAdjustment_userId_fkey", index: false)
    financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade, map: "BalanceAdjustment_financialAccountId_fkey", index: false)

    @@index([userId, financialAccountId, date], map: "BalanceAdjustment_userId_account_date_key", unique: true)
    @@map("BalanceAdjustment")
  }

  model FinancialAccountYieldRateHistory {
    id                 VarChar(36)                         @id(map: "FinancialAccountYieldRateHistory_pkey") @default(dbgenerated("cuid2()"))
    financialAccountId VarChar(36)
    effectiveDate      Date
    yieldReferenceType       pg.enum(ReferenceRateType)?
    yieldReferencePercentage Numeric(7, 4)?
    yieldFixedRate           Numeric(7, 4)?
    yieldTaxRate             Numeric(5, 2)?
    yieldPeriod              pg.enum(FinancialAccountYieldPeriod)?
    createdAt          Timestamp(3)                        @default(now())
    updatedAt          Timestamp(3)                        @default(now())
    financialAccount   FinancialAccount                    @relation(fields: [financialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FinancialAccountYieldRateHistory_financialAccountId_fkey", index: false)

    @@index([financialAccountId, effectiveDate], map: "FinancialAccountYieldRateHistory_accountId_effectiveDate_key", unique: true)
    @@map("FinancialAccountYieldRateHistory")
  }

  model FinancialAccountYield {
    id                 VarChar(36)                       @id(map: "FinancialAccountYield_pkey") @default(dbgenerated("cuid2()"))
    financialAccountId VarChar(36)
    date               Date
    time               Time(3)?
    amount             Numeric(12, 4)?
    isHidden           Boolean                           @default(false)
    externalId         VarChar(200)?
    kind               pg.enum(FinancialAccountYieldKind)
    origin             pg.enum(FinancialAccountYieldOrigin) @default("USER")
    isExcluded         Boolean                           @default(false)
    createdAt          Timestamp(3)                      @default(now())
    updatedAt          Timestamp(3)                      @default(now())
    financialAccount   FinancialAccount                  @relation(fields: [financialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "FinancialAccountYield_financialAccountId_fkey", index: false)

    @@index([financialAccountId, date, kind], map: "FinancialAccountYield_accountId_date_kind_key", unique: true)
    @@index([externalId], map: "FinancialAccountYield_externalId_idx")
    @@map("FinancialAccountYield")
  }

  model ReferenceRate {
    id        VarChar(36)                  @id(map: "ReferenceRate_pkey") @default(dbgenerated("cuid2()"))
    type      pg.enum(ReferenceRateType)
    date      Date
    value     Numeric(12, 8)
    createdAt Timestamp(3)                 @default(now())
    updatedAt Timestamp(3)                 @default(now())

    @@index([type, date], map: "ReferenceRate_type_date_key", unique: true)
    @@map("ReferenceRate")
  }

  model OutboxEvent {
    id            VarChar(36)  @id(map: "OutboxEvent_pkey")
    eventType     VarChar(120)
    aggregateType VarChar(80)
    aggregateId   VarChar(36)
    userIds       VarChar(36)[]
    occurredAt    Timestamp(3)
    schemaVersion Int          @default(1)
    correlationId VarChar(36)
    payload       Json         @default("{}")
    attempts      Int          @default(0)
    lockedUntil   Timestamp(3)?
    publishedAt   Timestamp(3)?
    lastError     String?
    createdAt     Timestamp(3) @default(now())
    updatedAt     Timestamp(3) @default(now())
    @@index([publishedAt, lockedUntil, occurredAt, id], map: "OutboxEvent_pending_idx")
    @@index([aggregateType, aggregateId, occurredAt], map: "OutboxEvent_aggregate_idx")
    @@map("OutboxEvent")
  }
  model ConsumerReceipt {
    consumer    VarChar(120)
    eventId     VarChar(36)
    attempts    Int          @default(0)
    lockedUntil Timestamp(3)?
    completedAt Timestamp(3)?
    lastError   String?
    createdAt   Timestamp(3) @default(now())
    updatedAt   Timestamp(3) @default(now())
    @@id([consumer, eventId], map: "ConsumerReceipt_pkey")
    @@index([completedAt, createdAt], map: "ConsumerReceipt_cleanup_idx")
    @@map("ConsumerReceipt")
  }
  model CreditCard {
    id                   VarChar(36)           @id(map: "CreditCard_pkey") @default(dbgenerated("cuid2()"))
    financialAccountId   VarChar(36)
    creditLimit          Numeric(12, 2)
    securityDeposit      Numeric(12, 2)?
    excludeFromTotals    Boolean               @default(false)
    ignoreStatementsBefore Date?
    statementDay         SmallInt
    dueDay               SmallInt
    workingDueDate       Boolean               @default(false)
    cashbackRate         Numeric(5, 2)?
    cashbackAccountId    VarChar(36)?
    cashbackYieldReferenceRate       Numeric(7, 4)?
    cashbackYieldReferencePercentage Numeric(7, 4)?
    cashbackYieldPeriod              pg.enum(CashbackYieldPeriod)?
    createdAt            Timestamp(3)          @default(now())
    updatedAt            Timestamp(3)          @default(now())
    creditCardHistories  CreditCardHistory[]
    creditCardStatements CreditCardStatement[]
    normalizedPurchases CreditPurchaseRecord[]
    creditCardImports    CreditCardImport[]
    payments Transaction[]
    importedPayments TransactionImportItem[]
    financialAccount     FinancialAccount      @relation(name: "CreditCard_accountId_fkey", fields: [financialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditCard_accountId_fkey")
    cashbackAccount      FinancialAccount?     @relation(name: "CreditCard_cashbackAccountId_fkey", fields: [cashbackAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditCard_cashbackAccountId_fkey", index: false)

    @@index([financialAccountId], map: "CreditCard_accountId_key", unique: true)
    @@index([cashbackAccountId], map: "CreditCard_cashbackAccountId_idx")

    @@map("CreditCard")
  }

  model RewardsAccount {
    id                    VarChar(36)                   @id(map: "RewardsAccount_pkey") @default(dbgenerated("cuid2()"))
    financialAccountId    VarChar(36)                   @unique(map: "RewardsAccount_financialAccountId_key")
    kind                  pg.enum(RewardsAccountKind)
    initialBalance        Numeric(18, 4)
    conversionPoints      Numeric(18, 4)?
    conversionAmount      Numeric(12, 2)?
    createdAt             Timestamp(3)                  @default(now())
    updatedAt             Timestamp(3)                  @default(now())
    financialAccount      FinancialAccount              @relation(fields: [financialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "RewardsAccount_financialAccountId_fkey")

    @@map("RewardsAccount")
  }

  model CreditCardHistory {
    id           VarChar(36)  @id(map: "CreditCardHistory_pkey") @default(dbgenerated("cuid2()"))
    creditCardId VarChar(36)
    field        VarChar(50)
    oldValue     String?
    newValue     String?
    changedAt    Timestamp(3) @default(now())
    creditCard   CreditCard   @relation(fields: [creditCardId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditCardHistory_creditCardId_fkey", index: false)

    @@map("CreditCardHistory")
  }

  model CreditCardStatement {
    id              VarChar(36)      @id(map: "CreditCardStatement_pkey") @default(dbgenerated("cuid2()"))
    creditCardId    VarChar(36)
    statementDate   Date
    dueDate         Date
    totalAmount     Numeric(12, 2)   @default(dbgenerated("0"))
    paidAmount      Numeric(12, 2)   @default(dbgenerated("0"))
    isPaid          Boolean          @default(false)
    isFullySynced   Boolean          @default(false)
    createdAt       Timestamp(3)     @default(now())
    updatedAt       Timestamp(3)     @default(now())
    normalizedInstallments CreditInstallmentRecord[]
    normalizedRefunds CreditRefundRecord[]
    statementCharges CreditStatementCharge[]
    creditCard      CreditCard       @relation(fields: [creditCardId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditCardStatement_creditCardId_fkey", index: false)

    @@index([creditCardId, statementDate], map: "CreditCardStatement_creditCardId_statementDate_key", unique: true)

    @@map("CreditCardStatement")
  }

  // Canonical purchases and their independent invoice occurrences.
  model CreditPurchaseRecord {
    id                   VarChar(36) @id(map: "CreditPurchaseRecord_pkey")
    userId               VarChar(36)
    creditCardId         VarChar(36)
    description          VarChar(500)
    storeName            VarChar(200)?
    purchaseDate         Date
    time                 Time(3)?
    totalAmount          Numeric(12, 2)
    feeDescription       VarChar(100)?
    feeAmount            Numeric(12, 2)?
    refinancingFeeAmount Numeric(12, 2)?
    categoryId           VarChar(36)?
    cashbackAccountId    VarChar(36)?
    cashbackAmount       Numeric(18, 4)?
    cashbackYieldReferenceRate       Numeric(7, 4)?
    cashbackYieldReferencePercentage Numeric(7, 4)?
    cashbackYieldPeriod              pg.enum(CashbackYieldPeriod)?
    subscriptionId       VarChar(36)?
    subscriptionOccurrenceDate Date?
    externalId           VarChar(200)?
    createdAt            Timestamp(3) @default(now())
    updatedAt            Timestamp(3) @default(now())
    user                 User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditPurchaseRecord_userId_fkey", index: false)
    creditCard           CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditPurchaseRecord_creditCardId_fkey", index: false)
    category             Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditPurchaseRecord_categoryId_fkey", index: false)
    installmentPlan      CreditInstallmentPlan[]
    installments         CreditInstallmentRecord[] @relation("PurchaseInstallments")
    refunds              CreditRefundRecord[]
    entryReferences      CreditEntryReference[]
    settledInstallments  CreditInstallmentRecord[] @relation("SettledInstallments")
    settledCharges       CreditStatementCharge[] @relation("SettledCharges")
    cashbackAccount      FinancialAccount? @relation("PurchaseCashback", fields: [cashbackAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditPurchaseRecord_cashbackAccountId_fkey", index: false)
    subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditPurchaseRecord_subscriptionId_fkey", index: false)
    legacyEntries        CreditPurchaseLegacyEntry[]

    @@index([userId, purchaseDate, createdAt, id], map: "CreditPurchaseRecord_userId_date_idx")
    @@index([creditCardId, purchaseDate], map: "CreditPurchaseRecord_creditCardId_date_idx")
    @@index([categoryId], map: "CreditPurchaseRecord_categoryId_idx")
    @@index([externalId], map: "CreditPurchaseRecord_externalId_key", unique: true)
    @@index([subscriptionId, subscriptionOccurrenceDate], map: "CreditPurchaseRecord_subscription_occurrence_key", unique: true)
    @@map("CreditPurchaseRecord")
  }

  model CreditInstallmentPlan {
    purchaseId       VarChar(36)
    number           SmallInt
    amount           Numeric(12, 2)
    hasImportedAmount Boolean @default(false)
    statementDate     Date?
    dueDate           Date?
    createdAt        Timestamp(3) @default(now())
    updatedAt        Timestamp(3) @default(now())
    purchase         CreditPurchaseRecord @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditInstallmentPlan_purchaseId_fkey", index: false)

    @@id([purchaseId, number], map: "CreditInstallmentPlan_pkey")
    @@map("CreditInstallmentPlan")
  }

  model CreditInstallmentRecord {
    id                    VarChar(36) @id(map: "CreditInstallmentRecord_pkey")
    purchaseId            VarChar(36)
    statementId           VarChar(36)
    number                SmallInt
    amount                Numeric(12, 2)
    occurrenceDate        Date
    hasImportedAmount     Boolean @default(false)
    settledByPurchaseId   VarChar(36)?
    isSettled             Boolean @default(false)
    settledByPurchase     CreditPurchaseRecord? @relation("SettledInstallments", fields: [settledByPurchaseId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditInstallmentRecord_settledByPurchaseId_fkey", index: false)
    entryReference        CreditEntryReference? @relation("EntryInstallment")
    createdAt             Timestamp(3) @default(now())
    updatedAt             Timestamp(3) @default(now())
    purchase              CreditPurchaseRecord @relation("PurchaseInstallments", fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditInstallmentRecord_purchaseId_fkey", index: false)
    statement             CreditCardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditInstallmentRecord_statementId_fkey", index: false)

    legacyEntry           CreditPurchaseLegacyEntry? @relation("LegacyInstallment")

    @@index([purchaseId, number], map: "CreditInstallmentRecord_purchase_number_key", unique: true)
    @@index([statementId, occurrenceDate], map: "CreditInstallmentRecord_statement_date_idx")
    @@map("CreditInstallmentRecord")
  }

  model CreditRefundRecord {
    id                   VarChar(36) @id(map: "CreditRefundRecord_pkey")
    purchaseId           VarChar(36)
    statementId          VarChar(36)
    creditDate           Date
    amount               Numeric(12, 2)
    policy               pg.enum(CreditRefundPolicy)
    time                 Time(3)?
    externalId           VarChar(200)? @unique(map: "CreditRefundRecord_externalId_key")
    entryReference       CreditEntryReference? @relation("EntryRefund")
    cancellationEligible Boolean @default(false)
    deletedAt            Timestamp(3)?
    createdAt            Timestamp(3) @default(now())
    updatedAt            Timestamp(3) @default(now())
    purchase             CreditPurchaseRecord @relation(fields: [purchaseId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditRefundRecord_purchaseId_fkey", index: false)
    statement            CreditCardStatement @relation(fields: [statementId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditRefundRecord_statementId_fkey", index: false)

    legacyEntry          CreditPurchaseLegacyEntry? @relation("LegacyRefund")

    @@index([purchaseId, creditDate], map: "CreditRefundRecord_purchase_date_idx")
    @@index([statementId, creditDate], map: "CreditRefundRecord_statement_date_idx")
    @@map("CreditRefundRecord")
  }

  model CreditStatementCharge {
    id          VarChar(36) @id(map: "CreditStatementCharge_pkey")
    statementId VarChar(36)
    description VarChar(500)
    amount      Numeric(12, 2)
    chargeDate  Date
    time        Time(3)?
    externalId  VarChar(200)? @unique(map: "CreditStatementCharge_externalId_key")
    settledByPurchaseId VarChar(36)?
    settledByPurchase CreditPurchaseRecord? @relation("SettledCharges", fields: [settledByPurchaseId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditStatementCharge_settledByPurchaseId_fkey", index: false)
    entryReference CreditEntryReference? @relation("EntryCharge")
    isSettled   Boolean @default(false)
    createdAt   Timestamp(3) @default(now())
    updatedAt   Timestamp(3) @default(now())
