    newValue      String?
    changedAt     Timestamp(3) @default(now())
    transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionHistory_transactionId_fkey", index: false)

    @@map("TransactionHistory")
  }

  model Verification {
    id         VarChar(36)  @id(map: "verification_pkey") @default(dbgenerated("cuid2()"))
