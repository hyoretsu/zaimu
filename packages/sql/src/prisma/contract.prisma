    id                   VarChar(36) @id(map: "CreditPurchaseRecord_pkey")
    userId               VarChar(36)
    creditCardId         VarChar(36)
    description          VarChar(500)
    storeName            VarChar(200)?
    purchaseDate         Date
    time                 Time(3)?
    totalAmount          Numeric(12, 2)
    feeDescription       VarChar(100)?
    feeAmount            Numeric(12, 2)?
    refinancingFeeAmount Numeric(12, 2)?
    cashbackAccountId    VarChar(36)?
    cashbackAmount       Numeric(18, 4)?
    cashbackYieldReferenceRate       Numeric(7, 4)?
    cashbackYieldReferencePercentage Numeric(7, 4)?
    cashbackYieldPeriod              pg.enum(CashbackYieldPeriod)?
    recurrenceId       VarChar(36)?
    recurrenceOccurrenceDate Date?
    externalId           VarChar(200)?
    createdAt            Timestamp(3) @default(now())
    updatedAt            Timestamp(3) @default(now())
    user                 User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditPurchaseRecord_userId_fkey", index: false)
    creditCard           CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditPurchaseRecord_creditCardId_fkey", index: false)
