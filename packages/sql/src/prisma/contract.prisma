    updatedAt Timestamp(3) @default(now())
    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OpenFinanceConfig_userId_fkey", index: false)
    @@map("OpenFinanceConfig")
  }
  model OpenFinanceConnection {
    id VarChar(36) @id(map: "OpenFinanceConnection_pkey")
