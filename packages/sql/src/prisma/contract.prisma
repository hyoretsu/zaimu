		@@index([subscriptionId, changedAt, id], map: "SubscriptionHistory_subscriptionId_changedAt_id_idx")
    @@map("SubscriptionHistory")
  }

  model Transaction {
    id                            VarChar(36)              @id(map: "Transaction_pkey") @default(dbgenerated("cuid2()"))
    userId                        VarChar(36)
    amount                        Numeric(12, 2)
    date                          Date
    time                          Time(3)?
    description                   VarChar(1000)?
    storeName                     VarChar(200)?
    isHidden                      Boolean                  @default(false)
    type                          pg.enum(TransactionType) @default("EXPENSE")
    categoryId                    VarChar(36)?
    recurrenceId                  VarChar(36)?
    recurrenceOccurrenceDate      Date?
    salaryId                      VarChar(36)?
    salaryOccurrenceDate          Date?
    subscriptionId                VarChar(36)?
    subscriptionOccurrenceDate    Date?
    paymentCreditCardId         VarChar(36)?
    originFinancialAccountId      VarChar(36)?
    destinationFinancialAccountId VarChar(36)?
    createdAt                     Timestamp(3)             @default(now())
    updatedAt                     Timestamp(3)             @default(now())
    transactionHistories          TransactionHistory[]
    debtTransactionLinks          DebtTransactionLink[]
    debtSplit                     DebtSplit?
    category                      Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_categoryId_fkey", index: false)
    paymentCreditCard             CreditCard?     @relation(fields: [paymentCreditCardId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_paymentCreditCardId_fkey", index: false)
    destinationFinancialAccount   FinancialAccount?        @relation(name: "Transaction_destinationId_fkey", fields: [destinationFinancialAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_destinationId_fkey", index: false)
    originFinancialAccount        FinancialAccount?        @relation(name: "Transaction_originId_fkey", fields: [originFinancialAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_originId_fkey", index: false)
    recurrence                    RecurringPayment?        @relation(fields: [recurrenceId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_recurrenceId_fkey", index: false)
    salary                        Salary?                  @relation(fields: [salaryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_salaryId_fkey", index: false)
    subscription                  Subscription?            @relation(fields: [subscriptionId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "Transaction_subscriptionId_fkey", index: false)
    user                          User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "Transaction_userId_fkey", index: false)
    externalReferences            TransactionExternalReference[]
    reconciledImportItems         TransactionImportItem[] @relation(name: "TransactionImportItem_reconciledTransactionId_fkey")
    firstTransferSuggestionRejections TransactionTransferSuggestionRejection[] @relation(name: "TransactionTransferSuggestionRejection_firstTransactionId_fkey")
    secondTransferSuggestionRejections TransactionTransferSuggestionRejection[] @relation(name: "TransactionTransferSuggestionRejection_secondTransactionId_fkey")

    @@index([recurrenceId, recurrenceOccurrenceDate], map: "Transaction_recurrenceId_occurrenceDate_key", unique: true)
    @@index([salaryId, salaryOccurrenceDate], map: "Transaction_salaryId_occurrenceDate_key", unique: true)
    @@index([subscriptionId, subscriptionOccurrenceDate], map: "Transaction_subscriptionId_occurrenceDate_key", unique: true)
    @@index([paymentCreditCardId], map: "Transaction_paymentCreditCardId_idx")
    @@index([userId, date, createdAt, id], map: "Transaction_userId_date_createdAt_id_idx")
    @@index([userId, originFinancialAccountId, date, id], map: "Transaction_userId_origin_date_id_idx")
    @@index([userId, destinationFinancialAccountId, date, id], map: "Transaction_userId_destination_date_id_idx")
    @@map("Transaction")
  }

  model TransactionExternalReference {
    id                 VarChar(36)  @id(map: "TransactionExternalReference_pkey") @default(dbgenerated("cuid2()"))
    transactionId      VarChar(36)
    financialAccountId VarChar(36)
    externalId         VarChar(200)
    createdAt          Timestamp(3) @default(now())
    updatedAt          Timestamp(3) @default(now())
    transaction        Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionExternalReference_transactionId_fkey", index: false)
    financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionExternalReference_financialAccountId_fkey", index: false)

    @@index([financialAccountId, externalId], map: "TransactionExternalReference_accountId_externalId_key", unique: true)
    @@index([transactionId], map: "TransactionExternalReference_transactionId_idx")
    @@map("TransactionExternalReference")
  }

  model CreditCardImport {
    id            VarChar(36)                   @id(map: "CreditCardImport_pkey") @default(dbgenerated("cuid2()"))
    userId        VarChar(36)
    creditCardId  VarChar(36)
    provider      pg.enum(CreditCardImportProvider)
    status        pg.enum(TransactionImportStatus) @default("PENDING")
    fileName      VarChar(255)
    statementDate Date
    reportedPreviousBalance Numeric(12, 2)?
    dueDate       Date
    createdAt     Timestamp(3)                  @default(now())
    updatedAt     Timestamp(3)                  @default(now())
    user          User                          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditCardImport_userId_fkey", index: false)
    creditCard    CreditCard                    @relation(fields: [creditCardId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditCardImport_creditCardId_fkey", index: false)
    items         CreditCardImportItem[]

    @@index([userId, status, createdAt], map: "CreditCardImport_userId_status_createdAt_idx")
    @@index([creditCardId], map: "CreditCardImport_creditCardId_idx")
    @@map("CreditCardImport")
  }

  model CreditCardImportItem {
    id                 VarChar(36)     @id(map: "CreditCardImportItem_pkey") @default(dbgenerated("cuid2()"))
    creditCardImportId VarChar(36)
    externalId         VarChar(200)
    purchaseDate       Date
    time               Time(3)?
    description        VarChar(500)
    storeName          VarChar(200)?
    totalAmount        Numeric(12, 2)
    installments       SmallInt        @default(1)
    currentInstallment SmallInt        @default(1)
    installmentAmount  Numeric(12, 2)
    categoryId         VarChar(36)?
    isStatementCharge  Boolean         @default(false)
    isSelected         Boolean         @default(true)
    reconciledCreditPurchaseId VarChar(36)? @unique(map: "CreditCardImportItem_reconciledCreditPurchaseId_key")
    createdAt          Timestamp(3)    @default(now())
    updatedAt          Timestamp(3)    @default(now())
    creditCardImport   CreditCardImport @relation(fields: [creditCardImportId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "CreditCardImportItem_importId_fkey", index: false)
    category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditCardImportItem_categoryId_fkey", index: false)
    debtSplit          DebtSplit?
    reconciledCreditPurchase CreditEntryReference? @relation(name: "CreditCardImportItem_reconciledCreditPurchaseId_fkey", fields: [reconciledCreditPurchaseId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "CreditCardImportItem_reconciledCreditPurchaseId_fkey", index: false)

    @@index([creditCardImportId, purchaseDate], map: "CreditCardImportItem_importId_purchaseDate_idx")
    @@index([externalId], map: "CreditCardImportItem_externalId_idx")
    @@map("CreditCardImportItem")
  }

  model TransactionImport {
    id                 VarChar(36)                         @id(map: "TransactionImport_pkey") @default(dbgenerated("cuid2()"))
    userId             VarChar(36)
    financialAccountId VarChar(36)
    provider           pg.enum(TransactionImportProvider)
    status             pg.enum(TransactionImportStatus)     @default("PENDING")
    fileName           VarChar(255)
    periodStart        Date?
    periodEnd          Date?
    createdAt          Timestamp(3)                         @default(now())
    updatedAt          Timestamp(3)                         @default(now())
    user               User                                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionImport_userId_fkey", index: false)
    financialAccount   FinancialAccount                     @relation(fields: [financialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionImport_financialAccountId_fkey", index: false)
    items              TransactionImportItem[]

    @@index([userId, status, createdAt], map: "TransactionImport_userId_status_createdAt_idx")
    @@index([financialAccountId], map: "TransactionImport_financialAccountId_idx")
    @@map("TransactionImport")
  }

  model TransactionImportItem {
    id                  VarChar(36)              @id(map: "TransactionImportItem_pkey") @default(dbgenerated("cuid2()"))
    transactionImportId VarChar(36)
    externalId          VarChar(200)?
    transferCounterpartExternalId VarChar(200)?
    amount              Numeric(12, 2)
    date                Date
    time                Time(3)?
    description         VarChar(1000)?
    storeName           VarChar(200)?
    type                pg.enum(TransactionImportItemType)
    categoryId          VarChar(36)?
    paymentCreditCardId         VarChar(36)?
    originFinancialAccountId      VarChar(36)?
    destinationFinancialAccountId VarChar(36)?
    isHidden            Boolean                  @default(false)
    isDuplicateIgnored  Boolean                  @default(false)
    isReconciled        Boolean                  @default(false)
    reconciledTransactionId VarChar(36)?
    reconciledImportItemId VarChar(36)?
    isSelected          Boolean                  @default(true)
    balanceAfter        Numeric(12, 2)?
    createdAt           Timestamp(3)             @default(now())
    updatedAt           Timestamp(3)             @default(now())
    transactionImport   TransactionImport         @relation(fields: [transactionImportId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionImportItem_importId_fkey", index: false)
    category            Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TransactionImportItem_categoryId_fkey", index: false)
    paymentCreditCard    CreditCard?      @relation(fields: [paymentCreditCardId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TransactionImportItem_paymentCreditCardId_fkey", index: false)
    originFinancialAccount FinancialAccount?      @relation(name: "TransactionImportItem_originId_fkey", fields: [originFinancialAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TransactionImportItem_originId_fkey", index: false)
    destinationFinancialAccount FinancialAccount? @relation(name: "TransactionImportItem_destinationId_fkey", fields: [destinationFinancialAccountId], references: [id], onDelete: SetNull, onUpdate: Cascade, map: "TransactionImportItem_destinationId_fkey", index: false)
    reconciledTransaction Transaction? @relation(name: "TransactionImportItem_reconciledTransactionId_fkey", fields: [reconciledTransactionId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "TransactionImportItem_reconciledTransactionId_fkey", index: false)
    reconciledImportItem TransactionImportItem? @relation(name: "TransactionImportItem_reconciledImportItemId_fkey", fields: [reconciledImportItemId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "TransactionImportItem_reconciledImportItemId_fkey", index: false)
    reconciledByImportItems TransactionImportItem[] @relation(name: "TransactionImportItem_reconciledImportItemId_fkey")
    debtSplit           DebtSplit?

    @@index([transactionImportId, date], map: "TransactionImportItem_importId_date_idx")
    @@index([externalId], map: "TransactionImportItem_externalId_idx")
    @@index([paymentCreditCardId], map: "TransactionImportItem_paymentCreditCardId_idx")
    @@index([originFinancialAccountId], map: "TransactionImportItem_originId_idx")
    @@index([destinationFinancialAccountId], map: "TransactionImportItem_destinationId_idx")
    @@index([reconciledTransactionId], map: "TransactionImportItem_reconciledTransactionId_idx")
    @@index([reconciledImportItemId], map: "TransactionImportItem_reconciledImportItemId_idx")
    @@map("TransactionImportItem")
  }

  model TransactionImportTransferSuggestionRejection {
    id                         VarChar(36)  @id(map: "TransactionImportTransferSuggestionRejection_pkey") @default(dbgenerated("cuid2()"))
    userId                     VarChar(36)
    outgoingFinancialAccountId VarChar(36)
    outgoingExternalId         VarChar(200)
    incomingFinancialAccountId VarChar(36)
    incomingExternalId         VarChar(200)
    createdAt                  Timestamp(3) @default(now())
    updatedAt                  Timestamp(3) @default(now())
    user                       User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionImportTransferSuggestionRejection_userId_fkey", index: false)
    outgoingFinancialAccount   FinancialAccount @relation(name: "TransactionImportTransferSuggestionRejection_outgoingAccountId_fkey", fields: [outgoingFinancialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionImportTransferRejection_outgoing_fkey", index: false)
    incomingFinancialAccount   FinancialAccount @relation(name: "TransactionImportTransferSuggestionRejection_incomingAccountId_fkey", fields: [incomingFinancialAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionImportTransferRejection_incoming_fkey", index: false)

    @@index([userId, outgoingFinancialAccountId, outgoingExternalId, incomingFinancialAccountId, incomingExternalId], map: "TransactionImportTransferSuggestionRejection_pair_key", unique: true)
    @@map("TransactionImportTransferSuggestionRejection")
  }

  model TransactionTransferSuggestionRejection {
    id                  VarChar(36)  @id(map: "TransactionTransferSuggestionRejection_pkey") @default(dbgenerated("cuid2()"))
    userId              VarChar(36)
    firstTransactionId  VarChar(36)
    secondTransactionId VarChar(36)
    createdAt           Timestamp(3) @default(now())
    updatedAt           Timestamp(3) @default(now())
    user                User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionTransferSuggestionRejection_userId_fkey", index: false)
    firstTransaction    Transaction  @relation(name: "TransactionTransferSuggestionRejection_firstTransactionId_fkey", fields: [firstTransactionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionTransferSuggestionRejection_firstTransactionId_fkey", index: false)
    secondTransaction   Transaction  @relation(name: "TransactionTransferSuggestionRejection_secondTransactionId_fkey", fields: [secondTransactionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionTransferSuggestionRejection_secondTransactionId_fkey", index: false)

    @@index([userId, firstTransactionId, secondTransactionId], map: "TransactionTransferSuggestionRejection_pair_key", unique: true)
    @@map("TransactionTransferSuggestionRejection")
  }

  model TransactionHistory {
    id            VarChar(36)  @id(map: "TransactionHistory_pkey") @default(dbgenerated("cuid2()"))
    transactionId VarChar(36)
    field         VarChar(50)
    oldValue      String?
    newValue      String?
    changedAt     Timestamp(3) @default(now())
    transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "TransactionHistory_transactionId_fkey", index: false)

    @@map("TransactionHistory")
  }

  model Verification {
    id         VarChar(36)  @id(map: "verification_pkey") @default(dbgenerated("cuid2()"))
    identifier VarChar(320)
    value      String
    expiresAt  Timestamp(3)
    createdAt  Timestamp(3) @default(now())
    updatedAt  Timestamp(3) @default(now())

    @@index([identifier], map: "verification_identifier_idx")
    @@map("verification")
  }

