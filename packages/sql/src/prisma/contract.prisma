    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OpenFinanceConnection_userId_fkey", index: false)
    bindings OpenFinanceBinding[]
    @@index([userId, itemId], map: "OpenFinanceConnection_user_item_key", unique: true)
    @@map("OpenFinanceConnection")
  }
  model OpenFinanceBinding {
    id VarChar(36) @id(map: "OpenFinanceBinding_pkey")
    connectionId VarChar(36)
    remoteAccountId String
    financialAccountId VarChar(36)?
    creditCardId VarChar(36)?
    paused Boolean @default(false)
    connection OpenFinanceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OpenFinanceBinding_connectionId_fkey", index: false)
    @@index([connectionId, remoteAccountId], map: "OpenFinanceBinding_connection_account_key", unique: true)
    @@map("OpenFinanceBinding")
  }
  model OpenFinanceRun {
    id VarChar(36) @id(map: "OpenFinanceRun_pkey")
    userId VarChar(36)
    status String
    processed Int @default(0)
    imported Int @default(0)
    linked Int @default(0)
    pending Int @default(0)
    errors Json @default("[]")
    startedAt Timestamp(3) @default(now())
    finishedAt Timestamp(3)?
    lockedUntil Timestamp(3)?
    workerToken VarChar(36)?
    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OpenFinanceRun_userId_fkey", index: false)
    @@index([userId, startedAt], map: "OpenFinanceRun_user_started_idx")
    @@map("OpenFinanceRun")
  }
  model OpenFinanceRecord {
    id VarChar(36) @id(map: "OpenFinanceRecord_pkey")
    userId VarChar(36)
    remoteAccountId String
    identity String
    snapshot Json
    appliedSnapshot Json?
    localKind String?
    localId VarChar(36)?
    importId VarChar(36)?
    reviewItemId VarChar(36)?
    state String
    updatedAt Timestamp(3) @default(now())
    user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OpenFinanceRecord_userId_fkey", index: false)
    identities OpenFinanceIdentity[]
    @@index([userId, remoteAccountId, identity], map: "OpenFinanceRecord_identity_key", unique: true)
    @@map("OpenFinanceRecord")
  }
  model OpenFinanceIdentity {
    userId VarChar(36)
    remoteAccountId String
    externalId String
    recordId VarChar(36)
    record OpenFinanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "OpenFinanceIdentity_recordId_fkey", index: false)
    @@id([userId, remoteAccountId, externalId], map: "OpenFinanceIdentity_pkey")
    @@map("OpenFinanceIdentity")
  }

  model User {
    openFinanceConfig OpenFinanceConfig?
    openFinanceConnections OpenFinanceConnection[]
    openFinanceRuns OpenFinanceRun[]
    openFinanceRecords OpenFinanceRecord[]
    creditRefundReviews CreditRefundReview[]
    id                VarChar(36)        @id(map: "User_pkey") @default(dbgenerated("cuid2()"))
    email             VarChar(320)
    name              VarChar(100)
    createdAt         Timestamp(3)       @default(now())
    updatedAt         Timestamp(3)       @default(now())
    emailVerified     Boolean            @default(false)
    image             VarChar(2048)?
    categories        Category[]
    stores            Store[]
    debtPeople        DebtPerson[]
    debtEvents        DebtEvent[]
    debtEventVisibilities DebtEventVisibility[]
