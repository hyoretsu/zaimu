{
	"name": "sql",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"check-types": "bun check",
		"export": "prisma contract emit --output-path out/prisma",
		"db:sign": "prisma db sign",
		"db:verify": "prisma db verify",
		"migrate:deploy": "bun scripts/migrate.ts",
		"migration:check": "prisma migration check",
		"migration:plan": "prisma migration plan",
		"migration:status": "prisma migration status",
		"test": "bun run ../../scripts/test-runner.ts sql all",
		"test:unit": "bun run ../../scripts/test-runner.ts sql unit",
		"test:integration": "bun run ../../scripts/test-runner.ts sql integration",
		"test:e2e": "bun run ../../scripts/test-runner.ts sql e2e"
	},
	"dependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.22",
		"dotenv": "^17.4.2",
		"pg": "8.22.0",
		"@zaimu/observability": "workspace:*"
	},
	"devDependencies": {
		"@hyoretsu/configs": "^1.2.37",
		"prisma": "8.0.0-rc.29",
		"@types/node": "^25.9.6",
		"@types/pg": "8.20.4",
		"typescript": "^6.0.3"
	}
}
