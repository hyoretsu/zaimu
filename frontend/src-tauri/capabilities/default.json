{
	"$schema": "../gen/schemas/desktop-schema.json",
	"description": "Permissões da janela principal do Zaimu",
	"identifier": "default",
	"permissions": [
		"core:default",
		"deep-link:default",
		{
			"allow": [
				{
					"url": "https://meu.pluggy.ai/*"
				},
				{
					"url": "https://dashboard.pluggy.ai/*"
				}
			],
			"identifier": "opener:allow-open-url"
		}
	],
	"windows": ["main"]
}
