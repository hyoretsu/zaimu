{
	"name": "frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"build": "tsc -b && vite build",
		"build:associated": "bun run links:generate --strict && bun run build",
		"links:generate": "bun scripts/generate-app-links.ts",
		"preview": "vite preview",
		"start": "vite preview",
		"test": "bun test",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "bun run links:generate --strict && tauri build --config src-tauri/tauri.links.conf.json",
		"tauri:android": "tauri android dev",
		"tauri:ios": "tauri ios dev",
		"test:open-finance": "playwright test --config playwright.open-finance.config.ts",
		"check-types": "tsc -b --noEmit"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.3.0",
		"@hugeicons/react": "^1.1.10",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-deep-link": "~2.4.9",
		"@tauri-apps/plugin-http": "^2.5.9",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"@tauri-apps/plugin-store": "^2.4.4",
		"@zaimu/finance": "workspace:*",
		"better-auth": "1.7.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.2.6",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-icons": "^5.7.0",
		"react-number-format": "^5.4.5",
		"recharts": "3.8.0",
		"shadcn": "^4.19.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
