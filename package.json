{
	"name": "zaimu",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.12",
	"workspaces": [
		"backend",
		"frontend",
		"packages/*"
	],
	"scripts": {
		"build": "turbo build",
		"check-types": "turbo check-types",
		"commit": "git add . && bun committier ai",
		"dev": "turbo dev",
		"dev:frontend": "bun -F frontend tauri dev",
		"format": "bun format:biome . && bun format:eslint .",
		"format:biome": "bunx biome check --diagnostic-level=error --write --unsafe",
		"format:eslint": "bunx eslint --quiet --fix",
		"prepare": "bun run ./prepare.ts || true",
		"start": "turbo start",
		"test": "bun run test:runner && bun run scripts/test-runner.ts backend all && bun run scripts/test-runner.ts sql all",
		"test:unit": "bun run scripts/test-runner.ts backend unit && bun run scripts/test-runner.ts sql unit",
		"test:integration": "bun run scripts/test-runner.ts backend integration && bun run scripts/test-runner.ts sql integration",
		"test:e2e": "bun run scripts/test-runner.ts backend e2e && bun run scripts/test-runner.ts sql e2e",
		"test:runner": "bun test scripts/testing --timeout 45000"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@commitlint/types": "^20.5.0",
		"@eslint/js": "^10.0.1",
		"@hyoretsu/configs": "^1.2.37",
		"@types/bun": "^1.4.0",
		"@types/node": "^25.9.5",
		"committier": "^0.2.3",
		"eslint": "^10.9.1",
		"eslint-config-biome": "^2.1.3",
		"lint-staged": "^16.4.0",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0"
	},
	"patchedDependencies": {
		"better-auth@1.7.1": "patches/better-auth@1.7.1.patch",
		"@better-auth/core@1.7.1": "patches/@better-auth%2Fcore@1.7.1.patch"
	}
}
