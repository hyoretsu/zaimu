{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"backend#build": {
			"dependsOn": ["^contract:emit", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["scripts/inject.ts", "src/**", ".env*"],
			"outputLogs": "new-only",
			"outputs": ["dist/**"]
		},
		"backend#check-types": {
			"dependsOn": ["^contract:emit", "generate"],
			"inputs": ["src/**", "performance/**/*.ts", "tsconfig*.json"],
			"outputLogs": "new-only"
		},
		"backend#dev": {
			"cache": false,
			"dependsOn": ["^contract:emit", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL"],
			"persistent": true
		},
		"build": {
			"dependsOn": ["^contract:emit", "generate"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**"]
		},
		"check-types": {
			"dependsOn": ["^contract:emit", "generate"],
			"inputs": ["src/**", "tsconfig*.json"],
			"outputLogs": "new-only"
		},
		"contract:emit": {
			"env": ["DATABASE_URL"],
			"inputs": ["src/prisma/contract.prisma", "prisma.config.ts"],
			"outputLogs": "new-only",
			"outputs": ["out/**"]
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^contract:emit", "generate"],
			"persistent": true
		},
		"export": {
			"dependsOn": ["^contract:emit", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["out/**"]
		},
		"frontend#build": {
			"dependsOn": ["^contract:emit", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**", ".next/**", "!.next/cache/**"]
		},
		"frontend#dev": {
			"cache": false,
			"dependsOn": ["^contract:emit", "generate"],
			"persistent": true
		},
		"frontend#generate": {
			"dependsOn": ["^contract:emit"],
			"inputs": ["kubb.config.ts"],
			"outputLogs": "new-only",
			"outputs": ["src/lib/api/generated/**"]
		},
		"generate": {
			"dependsOn": ["^contract:emit"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["src/generated/**"]
		},
		"migrate:deploy": {
			"env": ["DATABASE_URL", "DATABASE_TEST_URL"],
			"inputs": ["src/migrations/**"],
			"outputLogs": "new-only"
		},
		"test": {
			"dependsOn": ["test:e2e", "test:unit"]
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^contract:emit"],
			"env": ["DATABASE_TEST_URL", "DATABASE_URL"],
			"inputs": ["**/*.e2e.test.ts"]
		},
		"test:unit": {
			"dependsOn": ["^contract:emit"],
			"inputs": ["**/*.test.ts", "!**/*.e2e.test.ts"],
			"outputLogs": "new-only"
		}
	}
}
