{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["scripts/test-runner.ts", "scripts/testing/**", "shared/**"],
	"globalPassThroughEnv": ["OTEL_*"],
	"tasks": {
		"backend#build": {
			"dependsOn": ["^export", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["scripts/**", "src/**", ".env*", "$TURBO_ROOT$/shared/**"],
			"outputLogs": "new-only",
			"outputs": ["dist/**"],
		},
		"backend#check-types": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "performance/**/*.ts", "tsconfig*.json", "$TURBO_ROOT$/shared/**"],
			"outputLogs": "new-only",
		},
		"backend#dev": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"env": ["COMPANY_SLUG", "DATABASE_URL"],
			"persistent": true,
		},
		"backend#export": {
			"dependsOn": ["^export"],
			"inputs": ["$TURBO_DEFAULT$", "!out/**", "$TURBO_ROOT$/shared/**"],
			"outputLogs": "new-only",
			"outputs": ["out/openapi.json"],
		},
		"build": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**"],
		},
		"check-types": {
			"dependsOn": ["^export", "generate"],
			"inputs": ["src/**", "tsconfig*.json"],
			"outputLogs": "new-only",
		},
		"dev": {
			"cache": false,
			"dependsOn": ["^export", "generate"],
			"persistent": true,
		},
		"export": {
			"dependsOn": ["^export", "generate"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "scripts/export-openapi.ts", "package.json", "!src/**/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["out/**"],
		},
		"frontend#build": {
			"dependsOn": ["generate"],
			"env": ["DATABASE_URL", "VITE_API_URL", "VITE_APP_URL"],
			"inputs": ["$TURBO_DEFAULT$", "!src/lib/api/generated/**", "$TURBO_ROOT$/shared/**"],
			"outputLogs": "new-only",
			"outputs": ["build/**", "dist/**", "out/**", ".next/**", "!.next/cache/**"],
		},
		"frontend#check-types": {
			"dependsOn": ["generate"],
			"inputs": ["$TURBO_DEFAULT$", "!src/lib/api/generated/**", "$TURBO_ROOT$/shared/**"],
			"outputLogs": "new-only",
		},
		"frontend#dev": {
			"cache": false,
			"dependsOn": ["generate"],
			"inputs": ["$TURBO_DEFAULT$"],
			"persistent": true,
		},
		"frontend#generate": {
			"dependsOn": ["^export"],
			"inputs": ["kubb.config.ts", "scripts/generate-sdk.ts", "scripts/sdk-generation-cache.ts"],
			"outputLogs": "new-only",
			"outputs": ["src/lib/api/generated/**", ".cache/kubb-generation.json"],
		},
		"frontend#performance:test": {
			"cache": false,
			"dependsOn": ["generate"],
		},
		"frontend#test": {
			"cache": false,
			"dependsOn": ["generate"],
		},
		"frontend#test:currency": {
			"cache": false,
			"dependsOn": ["generate"],
		},
		"frontend#test:open-finance": {
			"cache": false,
			"dependsOn": ["generate"],
		},
		"generate": {
			"dependsOn": ["^export"],
			"env": ["DATABASE_URL"],
			"inputs": ["src/**", "!src/generated/**"],
			"outputLogs": "new-only",
			"outputs": ["src/generated/**"],
		},
		"migrate:deploy": {
			"env": ["DATABASE_URL", "DATABASE_TEST_URL"],
			"inputs": ["src/migrations/**"],
			"outputLogs": "new-only",
		},
		"sql#export": {
			"env": ["DATABASE_URL"],
			"inputs": ["src/prisma/contract.prisma", "prisma.config.ts"],
			"outputLogs": "new-only",
			"outputs": ["out/**"],
		},
		"test": {
			"cache": false,
			"dependsOn": ["^export"],
		},
		"test:e2e": {
			"cache": false,
			"dependsOn": ["^export"],
		},
		"test:integration": {
			"cache": false,
			"dependsOn": ["^export"],
		},
		"test:unit": {
			"cache": false,
			"dependsOn": ["^export"],
		},
	},
}
